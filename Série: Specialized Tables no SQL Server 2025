-- Post #2
-- Specialized Tables no SQL Server 2025: Temporal Tables
--
USE DP800_Lab;
GO

-- 1. Criando uma temporal table com history table nomeada
CREATE TABLE dbo.Funcionario
(
    FuncionarioId  INT           NOT NULL PRIMARY KEY CLUSTERED,
    Nome           NVARCHAR(100) NOT NULL,
    Cargo          NVARCHAR(50)  NOT NULL,
    Salario        DECIMAL(10,2) NOT NULL,

    -- Colunas de período (HIDDEN = não aparecem no SELECT *)
    ValidoDe   DATETIME2 GENERATED ALWAYS AS ROW START HIDDEN NOT NULL,
    ValidoAte  DATETIME2 GENERATED ALWAYS AS ROW END   HIDDEN NOT NULL,
    PERIOD FOR SYSTEM_TIME (ValidoDe, ValidoAte)
)
WITH
(
    SYSTEM_VERSIONING = ON
    (
        HISTORY_TABLE = dbo.FuncionarioHistorico,
        HISTORY_RETENTION_PERIOD = 6 MONTHS  -- limpeza automática do histórico
    )
);
GO

-- 2. Gerando histórico: insert, updates e delete com pausas
INSERT INTO dbo.Funcionario (FuncionarioId, Nome, Cargo, Salario)
VALUES (1, N'Ana',   N'DBA Júnior', 5000),
       (2, N'Bruno', N'Dev',        6000);

WAITFOR DELAY '00:00:02';
UPDATE dbo.Funcionario SET Cargo = N'DBA Pleno', Salario = 8000 WHERE FuncionarioId = 1;

-- Guardando um "ponto no tempo" para usar no AS OF
DECLARE @Marco DATETIME2 = SYSUTCDATETIME();
SELECT @Marco AS MarcoUTC;

WAITFOR DELAY '00:00:02';
UPDATE dbo.Funcionario SET Cargo = N'DBA Sênior', Salario = 12000 WHERE FuncionarioId = 1;
DELETE FROM dbo.Funcionario WHERE FuncionarioId = 2;

-- 3. Estado atual (repare que o SELECT * não traz as colunas HIDDEN)
SELECT * FROM dbo.Funcionario;

-- 4. Como os dados estavam no momento do @Marco
SELECT FuncionarioId, Nome, Cargo, Salario, ValidoDe, ValidoAte
FROM dbo.Funcionario
FOR SYSTEM_TIME AS OF @Marco;
GO

-- 5. Linha do tempo completa da Ana (atual + histórico)
SELECT FuncionarioId, Nome, Cargo, Salario, ValidoDe, ValidoAte
FROM dbo.Funcionario
FOR SYSTEM_TIME ALL
WHERE FuncionarioId = 1
ORDER BY ValidoDe;

-- 6. Recuperando um registro excluído por engano
INSERT INTO dbo.Funcionario (FuncionarioId, Nome, Cargo, Salario)
SELECT TOP (1) FuncionarioId, Nome, Cargo, Salario
FROM dbo.FuncionarioHistorico
WHERE FuncionarioId = 2
ORDER BY ValidoAte DESC;

-- Tabela comum, já em produção
CREATE TABLE dbo.Produto
(
    ProdutoId INT           NOT NULL PRIMARY KEY,
    Nome      NVARCHAR(100) NOT NULL,
    Preco     DECIMAL(10,2) NOT NULL
);
GO

-- Adiciona as colunas de período com DEFAULT para as linhas existentes
ALTER TABLE dbo.Produto ADD
    ValidoDe  DATETIME2 GENERATED ALWAYS AS ROW START HIDDEN NOT NULL
        CONSTRAINT DF_Produto_ValidoDe DEFAULT SYSUTCDATETIME(),
    ValidoAte DATETIME2 GENERATED ALWAYS AS ROW END HIDDEN NOT NULL
        CONSTRAINT DF_Produto_ValidoAte DEFAULT CONVERT(DATETIME2, '9999-12-31 23:59:59.9999999'),
    PERIOD FOR SYSTEM_TIME (ValidoDe, ValidoAte);
GO

-- Liga o versionamento
ALTER TABLE dbo.Produto
    SET (SYSTEM_VERSIONING = ON (HISTORY_TABLE = dbo.ProdutoHistorico));
GO

-- Para mudanças de schema mais pesadas: desliga, altera, religa
