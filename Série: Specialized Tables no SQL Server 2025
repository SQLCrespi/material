-- ... alterações na tabela e na history table ...
ALTER TABLE dbo.Produto
    SET (SYSTEM_VERSIONING = ON (HISTORY_TABLE = dbo.ProdutoHistorico, DATA_CONSISTENCY_CHECK = ON));
GO

-- Limpeza opcional desta parte
ALTER TABLE dbo.Funcionario SET (SYSTEM_VERSIONING = OFF);
ALTER TABLE dbo.Produto     SET (SYSTEM_VERSIONING = OFF);
