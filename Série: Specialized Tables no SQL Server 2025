/* =====================================================
   Lab 3.2 – Parquet no Azure Blob (CETAS + leitura)
   Pré-requisito: Lab 3.1 concluído (ext_Cliente)
   ===================================================== */
USE DP800_Lab;
GO

-- 0. Database master key (necessária para a credential)
IF NOT EXISTS (SELECT 1 FROM sys.symmetric_keys WHERE name = '##MS_DatabaseMasterKey##')
    CREATE MASTER KEY ENCRYPTION BY PASSWORD = '<SenhaForte#2026>';
GO

-- 1. Credential (SAS sem o "?" inicial; sp=rwdlc, srt=co ou sco)
IF NOT EXISTS (SELECT 1 FROM sys.database_scoped_credentials WHERE name = 'cred_Blob')
    CREATE DATABASE SCOPED CREDENTIAL cred_Blob
    WITH IDENTITY = 'SHARED ACCESS SIGNATURE',
         SECRET   = '<SAS-token-sem-o-?>';
GO

-- 2. Data source (container@storageaccount, sem pasta)
IF NOT EXISTS (SELECT 1 FROM sys.external_data_sources WHERE name = 'ds_Blob')
    CREATE EXTERNAL DATA SOURCE ds_Blob
    WITH (LOCATION = 'abs://dp800@<storageaccount>.blob.core.windows.net',
          CREDENTIAL = cred_Blob);
GO

-- 3. File format
IF NOT EXISTS (SELECT 1 FROM sys.external_file_formats WHERE name = 'ff_Parquet')
    CREATE EXTERNAL FILE FORMAT ff_Parquet WITH (FORMAT_TYPE = PARQUET);
GO

-- 4. Dados locais de origem
DROP TABLE IF EXISTS dbo.VendaLocal;
CREATE TABLE dbo.VendaLocal (VendaId INT, ClienteId INT, Valor DECIMAL(10,2), DataVenda DATE);
INSERT INTO dbo.VendaLocal
SELECT TOP (1000)
       ROW_NUMBER() OVER (ORDER BY (SELECT 1)),
       ABS(CHECKSUM(NEWID())) % 3 + 1,
       ABS(CHECKSUM(NEWID())) % 500 + 0.99,
       DATEADD(DAY, ABS(CHECKSUM(NEWID())) % 365, '2025-01-01')
FROM sys.all_objects;
GO

-- 5. Habilitar exportação (CETAS)
EXEC sp_configure 'allow polybase export', 1;
RECONFIGURE;
GO

-- 6. CETAS: grava Parquet no Blob (esperado: 1000 rows affected)
CREATE EXTERNAL TABLE dbo.ext_VendasExport
WITH (LOCATION = 'vendas/2025/', DATA_SOURCE = ds_Blob, FILE_FORMAT = ff_Parquet)
AS SELECT * FROM dbo.VendaLocal;
GO

-- 7. Leitura ad hoc (schema inferido)
SELECT TOP (10) *
FROM OPENROWSET(BULK 'vendas/2025/*.parquet',
                DATA_SOURCE = 'ds_Blob',
                FORMAT = 'PARQUET') AS v;
GO

-- 8. External table para uso recorrente
CREATE EXTERNAL TABLE dbo.ext_Vendas
(VendaId INT, ClienteId INT, Valor DECIMAL(10,2), DataVenda DATE)
WITH (LOCATION = 'vendas/2025/', DATA_SOURCE = ds_Blob, FILE_FORMAT = ff_Parquet);
GO

-- 9. JOIN: Parquet (Blob) x SQL Server (loopback)
SELECT c.Nome, c.UF, COUNT(*) AS Qtde, SUM(v.Valor) AS Total
FROM dbo.ext_Vendas  AS v
JOIN dbo.ext_Cliente AS c ON c.ClienteId = v.ClienteId
GROUP BY c.Nome, c.UF
ORDER BY Total DESC;
GO

